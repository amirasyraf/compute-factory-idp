{$IDP_DOMAIN} {
  # JSON access log on stdout: client IP, status, size and duration for every request,
  # including ones Backstage only logs when they finish. Credentials headers are redacted.
  log {
    output stdout
    format json
  }
  # Public demo URL; preserve Backstage's authenticated plugin router behind it.
  @mockServiceNow path /mock-rest/servicenow
  rewrite @mockServiceNow /api/mock-rest/servicenow
  reverse_proxy backstage:7007
}
